# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html

# Go workspace
go.work
go.work.sum

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Mead runtime state (per-pid MCP lockfiles, etc.)
/.mead/

# Local notes that shouldn't ship
/scratch/
/notes-local/

# Wails build outputs
/build/bin/

# Runtime log
mead.log

# Frontend build artifacts (frontend/dist content is rebuilt every time;
# the directory itself must exist for go:embed to succeed — kept via gitkeep)
/frontend/node_modules/
/frontend/dist/*
!/frontend/dist/.gitkeep
# Wails-CLI install-cache marker — regenerated on every `wails build`
/frontend/package.json.md5

# Mead-owned Wine built by scripts/build-wine-macos.sh — the whole tree is
# .gitignored (each dev builds their own from known-good free sources; it's
# ~hundreds of MB and machine-specific). Includes bin/, lib/, overlay
# markers, and cxbuilder logs.
/scripts/wine/
# cxbuilder + wine-source scratch, if a dev points WORK_DIR back into the repo.
/scripts/.wine-build/
