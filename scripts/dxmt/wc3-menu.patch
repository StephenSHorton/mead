diff --git a/src/dxgi/dxgi_adapter.cpp b/src/dxgi/dxgi_adapter.cpp
index 1b3d37c..110fe1e 100644
--- a/src/dxgi/dxgi_adapter.cpp
+++ b/src/dxgi/dxgi_adapter.cpp
@@ -14,8 +14,16 @@ namespace dxmt {
 Com<IDXGIOutput> CreateOutput(IMTLDXGIAdapter *pAadapter, HMONITOR monitor, DxgiOptions &options);
 
 LUID GetAdapterLuid(WMT::Device device) {
-    // NOTE: use big-endian registryID, be consistent with MVK
-  return std::bit_cast<LUID>(__builtin_bswap64(device.registryID()));
+  // Return a small, Windows-like adapter LUID: {LowPart = low 32 bits of registryID, HighPart = 0}.
+  // Native Windows GPU LUIDs are small (HighPart = 0). Some D3D11 clients serialize the adapter LUID
+  // through a narrow integer and silently fail to match a large value — notably CEF/Chromium's
+  // cross-process accelerated shared-texture path (Battle.net's BlizzardBrowser, which composites the
+  // WC3 Reforged in-game menu): it passes the adapter LUID as a decimal command-line switch and could
+  // not match the previous big-endian registryID (huge HighPart), so the shared-texture factory failed
+  // to find the adapter. registryID is stable per-GPU within a boot, so a small LUID stays consistent
+  // across the producer/consumer processes. NOTE: this no longer equals MoltenVK's Vulkan device LUID
+  // (bswap64(registryID)); fine for the D3D-only path, revisit if D3D<->Vulkan LUID interop is needed.
+  return std::bit_cast<LUID>(static_cast<uint64_t>(static_cast<uint32_t>(device.registryID())));
 }
 
