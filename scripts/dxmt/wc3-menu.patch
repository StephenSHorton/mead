 namespace dxmt {
 
+// No-op IDXGIKeyedMutex for cross-process shared textures. CEF accelerated-OSR requires the texture
+// to expose IDXGIKeyedMutex and AcquireSync/ReleaseSync to succeed; for the single producer/consumer
+// WC3 menu overlay a no-op satisfies the contract (no tearing for a mostly-static menu). Validated
+// offline (tf.exe) before any real MTLSharedEvent-backed sync work. Aggregated into the owning
+// resource — all IUnknown/refcount/private-data calls delegate to it (mirrors MTLDXGIResource).
+template <typename TResource>
+class MTLDXGIKeyedMutex final : public IDXGIKeyedMutex {
+public:
+  MTLDXGIKeyedMutex(TResource *resource) : resource_(resource) {}
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void **ppv) final { return resource_->QueryInterface(riid, ppv); }
+  ULONG STDMETHODCALLTYPE AddRef() final { return resource_->AddRef(); }
+  ULONG STDMETHODCALLTYPE Release() final { return resource_->Release(); }
+  HRESULT STDMETHODCALLTYPE SetPrivateData(REFGUID g, UINT s, const void *d) final { return resource_->SetPrivateData(g, s, d); }
+  HRESULT STDMETHODCALLTYPE SetPrivateDataInterface(REFGUID g, const IUnknown *o) final { return resource_->SetPrivateDataInterface(g, o); }
+  HRESULT STDMETHODCALLTYPE GetPrivateData(REFGUID g, UINT *s, void *d) final { return resource_->GetPrivateData(g, s, d); }
+  HRESULT STDMETHODCALLTYPE GetParent(REFIID riid, void **pp) final { return resource_->GetDeviceInterface(riid, pp); }
+  HRESULT STDMETHODCALLTYPE GetDevice(REFIID riid, void **pp) final { return resource_->GetDeviceInterface(riid, pp); }
+  HRESULT STDMETHODCALLTYPE AcquireSync(UINT64, DWORD) final { return S_OK; }
+  HRESULT STDMETHODCALLTYPE ReleaseSync(UINT64) final { return S_OK; }
+private:
+  TResource *resource_;
+};
+
