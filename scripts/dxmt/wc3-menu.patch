diff --git a/src/dxgi/dxgi_factory.cpp b/src/dxgi/dxgi_factory.cpp
index 0b3fa09..f1d042f 100644
--- a/src/dxgi/dxgi_factory.cpp
+++ b/src/dxgi/dxgi_factory.cpp
@@ -206,8 +206,22 @@ public:
 
   HRESULT STDMETHODCALLTYPE GetSharedResourceAdapterLuid(HANDLE hResource,
                                                          LUID *pLuid) final {
-    ERR("Not implemented");
-    return E_NOTIMPL;
+    // Single Metal GPU: the shared resource belongs to the sole adapter. Return that
+    // adapter's real LUID (same value DXMT advertises via GetDesc1) instead of the old
+    // E_NOTIMPL stub, which left the caller's LUID uninitialized -> BlizzardBrowser's
+    // shared-texture factory then searched for a garbage LUID and failed. (WC3 menu fix.)
+    if (!pLuid)
+      return E_INVALIDARG;
+    IDXGIAdapter1 *handle = nullptr;
+    if (this->EnumAdapters1(0, &handle) != S_OK || !handle)
+      return DXGI_ERROR_NOT_FOUND;
+    DXGI_ADAPTER_DESC1 desc;
+    HRESULT hr = handle->GetDesc1(&desc);
+    handle->Release();
+    if (FAILED(hr))
+      return hr;
+    *pLuid = desc.AdapterLuid;
+    return S_OK;
   }
 
   HRESULT STDMETHODCALLTYPE MakeWindowAssociation(HWND WindowHandle,
@@ -258,7 +272,24 @@ public:
 
   HRESULT STDMETHODCALLTYPE EnumAdapterByLuid(LUID luid, REFIID iid,
                                               void **adapter) override {
-    ERR("DXGIFactory::EnumAdapterByLuid: not implemented");
+    // DXMT adapter LUIDs are stable per physical GPU across processes (see GetAdapterLuid), so a
+    // cross-process shared-texture consumer can locate the producer's adapter by LUID. Enumerate and
+    // match, reusing the tested EnumAdapters1 + GetDesc1 path. (Was a "not implemented" stub.)
+    InitReturnPtr(adapter);
+    IDXGIAdapter1 *handle = nullptr;
+    for (UINT i = 0; this->EnumAdapters1(i, &handle) == S_OK; i++) {
+      DXGI_ADAPTER_DESC1 desc;
+      if (SUCCEEDED(handle->GetDesc1(&desc)) &&
+          desc.AdapterLuid.LowPart == luid.LowPart &&
+          desc.AdapterLuid.HighPart == luid.HighPart) {
+        HRESULT hr = handle->QueryInterface(iid, adapter);
+        handle->Release();
+        return hr;
+      }
+      handle->Release();
+      handle = nullptr;
+    }
+    ERR("DXGIFactory::EnumAdapterByLuid: no adapter matches the requested LUID");
     return DXGI_ERROR_NOT_FOUND;
   }
 
